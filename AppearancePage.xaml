<Page
    x:Class="Fluent_Ricing.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="32,24">

            <TextBlock Text="Appearance"
                       Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Customise how your widgets look"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Theme -->
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="16,12">
                <StackPanel Spacing="12">
                    <TextBlock Text="Theme" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <RadioButtons x:Name="ThemeRadio" SelectionChanged="ThemeRadio_SelectionChanged">
                        <RadioButton Content="System default" Tag="System" IsChecked="True"/>
                        <RadioButton Content="Light" Tag="Light"/>
                        <RadioButton Content="Dark" Tag="Dark"/>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Backdrop -->
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="16,12">
                <StackPanel Spacing="12">
                    <TextBlock Text="Window Backdrop" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="Applied to the settings window"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="BackdropCombo" SelectedIndex="0"
                              SelectionChanged="BackdropCombo_SelectionChanged"
                              HorizontalAlignment="Left" MinWidth="220">
                        <ComboBoxItem Content="Mica"/>
                        <ComboBoxItem Content="Mica Alt"/>
                        <ComboBoxItem Content="Acrylic"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Widget Opacity -->
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="16,12">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Widget Opacity"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="OpacityValueLabel" Text="80%"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </Grid>
                    <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="80"
                            TickFrequency="10" TickPlacement="BottomRight"
                            ValueChanged="OpacitySlider_ValueChanged"/>
                </StackPanel>
            </Border>

            <!-- Font Size -->
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="16,12">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Widget Font Size"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="FontSizeValueLabel" Text="14px"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </Grid>
                    <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="24" Value="14"
                            TickFrequency="2" TickPlacement="BottomRight"
                            ValueChanged="FontSizeSlider_ValueChanged"/>
                </StackPanel>
            </Border>

            <!-- Widget Corner Radius -->
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="16,12">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Widget Corner Radius"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="CornerRadiusValueLabel" Text="8px"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </Grid>
                    <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="24" Value="8"
                            TickFrequency="4" TickPlacement="BottomRight"
                            ValueChanged="CornerRadiusSlider_ValueChanged"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>