<Window
    x:Class="Fluent_Ricing.Widgets.ClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent"
          PointerPressed="DragHandle_PointerPressed"
          PointerEntered="DragHandle_PointerEntered"
          PointerExited="DragHandle_PointerExited">

        <Border CornerRadius="16"
                Padding="20,16"
                Background="#22FFFFFF"
                BorderBrush="#40FFFFFF"
                BorderThickness="1">
            <StackPanel Spacing="2">
                <TextBlock x:Name="LabelText"
                           FontSize="12"
                           Foreground="#AAFFFFFF"
                           Margin="0,0,0,2"/>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText"
                               FontSize="48"
                               FontWeight="Light"
                               CharacterSpacing="-20"
                               Foreground="White"/>
                    <StackPanel Spacing="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <TextBlock x:Name="AmPmText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="SecondsText"
                                   FontSize="12"
                                   Foreground="#AAFFFFFF"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="DateText"
                           FontSize="12"
                           Foreground="#AAFFFFFF"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border CornerRadius="16"
                BorderBrush="#40FFFFFF"
                BorderThickness="0.5"
                IsHitTestVisible="False"/>

        <Border x:Name="ContextBar"
                CornerRadius="8"
                Padding="4"
                Background="#CC1C1C1E"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-36,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="EditButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="6"
                        ToolTipService.ToolTip="Settings"
                        Click="EditButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="12"/>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="6"
                        ToolTipService.ToolTip="Remove widget"
                        Click="CloseButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>