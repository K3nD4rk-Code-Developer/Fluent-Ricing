<Page
    x:Class="Fluent_Ricing.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="32,24">

            <TextBlock Text="Settings"
                       Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="App-wide configuration"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Startup -->
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="16,12">
                <StackPanel Spacing="12">
                    <TextBlock Text="System" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Launch at startup"
                                       Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock Text="Start Fluent Ricing when Windows starts"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Header="" IsOn="False"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Toggled="StartupToggle_Toggled"/>
                    </Grid>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Start minimized to tray"
                                       Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock Text="Hide the settings window on launch"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="StartMinimizedToggle" Header="" IsOn="False"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="About" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="Fluent Ricing"
                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Version 0.1.0 — Early Development"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="A desktop widget platform built with WinUI 3."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>